root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion

# Naming: PascalCase for types/methods/properties, camelCase for locals/parameters,
# UPPER_SNAKE_CASE-free — see docs/architecture/framework-rules.md and existing code for examples.
dotnet_naming_rule.types_pascal_case.severity = suggestion
dotnet_naming_rule.types_pascal_case.symbols = types
dotnet_naming_rule.types_pascal_case.style = pascal_case
dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum, record
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.interfaces_prefix_i.severity = suggestion
dotnet_naming_rule.interfaces_prefix_i.symbols = interfaces
dotnet_naming_rule.interfaces_prefix_i.style = prefix_i
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case

[*.{json,yml,yaml}]
indent_size = 2

[*.{csproj,props,targets,sln}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
