<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <!-- Rate Limiting (built-in .NET 9) - no extra package needed -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <!-- EF Core Design tools (for migrations) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SampleService.Application\SampleService.Application.csproj" />
    <ProjectReference Include="..\SampleService.Infrastructure\SampleService.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cross-service-boundary dependency: PackageReference only, per repo architecture rule
         (docs/architecture/framework-rules.md). Resolved from the local NuGet feed until
         Azure Artifacts is wired up — see nuget.config. -->
    <PackageReference Include="SakhaERP.Shared.Security" />
  </ItemGroup>

</Project>
