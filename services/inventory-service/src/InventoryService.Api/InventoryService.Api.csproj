<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <!-- Rate Limiting (built-in .NET 9) - no extra package needed -->
    <!-- Polly Resilience for HTTP clients -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <!-- Redis Distributed Cache -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <!-- EF Core Design tools (for migrations) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InventoryService.Application\InventoryService.Application.csproj" />
    <ProjectReference Include="..\InventoryService.Infrastructure\InventoryService.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cross-service-boundary dependency: PackageReference only, per repo architecture rule
         (docs: .claude/rules/architecture.md). Resolved from the local NuGet feed until
         Azure Artifacts is wired up — see nuget.config. -->
    <PackageReference Include="SakhaERP.Shared.Security" />
  </ItemGroup>

</Project>
